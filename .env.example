RETRIEVAL_METHOD=hybrid
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_RRF_K=60

# compose.yaml exposes Qdrant here. Leave empty only when intentionally using
# the embedded database under QDRANT_PATH.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=browsecomp_bge_large_en_v1_5
DENSE_MODEL_NAME=BAAI/bge-large-en-v1.5
DENSE_VECTOR_SIZE=1024
DENSE_API_URL=https://api.siliconflow.cn/v1/embeddings
